<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <!--
        快捷方式行始终占位（INVISIBLE 而非 GONE），item 高度不随其显示/隐藏变化，
        消除 RecyclerView 重新 measure 引起的抖动。
    -->

    <ImageView
        android:id="@+id/hideapp_iv_appicon"
        android:layout_width="40sp"
        android:layout_height="40sp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="16dp"
        android:src="@drawable/ic_null" />

    <com.google.android.material.checkbox.MaterialCheckBox
        android:id="@+id/hideapp_cb_ishidden"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="8dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:layout_toStartOf="@id/hideapp_cb_ishidden"
        android:layout_toEndOf="@id/hideapp_iv_appicon"
        android:orientation="vertical">

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/hideapp_tv_appname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="APP Name"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge" />

        <com.google.android.material.textview.MaterialTextView
            android:id="@+id/hideapp_tv_pkgname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="APP PkgName"
            android:textSize="8sp" />

        <!-- 始终占位，仅通过 VISIBLE/INVISIBLE 切换，不改变 item 高度 -->
        <LinearLayout
            android:id="@+id/hideapp_ll_shortcut"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp"
            android:visibility="invisible">

            <com.google.android.material.checkbox.MaterialCheckBox
                android:id="@+id/hideapp_cb_shortcut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="0dp"
                style="@style/Widget.Material3.CompoundButton.CheckBox" />

            <com.google.android.material.textview.MaterialTextView
                android:id="@+id/hideapp_tv_shortcut"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_shortcut"
                android:textSize="12sp"
                android:textColor="?attr/colorOnSurfaceVariant" />

        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
